{
  "tasks": {
    "start": "deno run --env-file=.env --allow-net=openrouter.ai,generativelanguage.googleapis.com --allow-env --allow-sys --allow-read=./data,./schema.sql,./fixtures,./wiki --allow-write=./data src/main.ts",
    "db:init": "deno run --allow-env=DATABASE_PATH,LOCK_TIMEOUT_MS,MAX_RETRIES,LOG_LEVEL,DEV_UI_PORT,PORT,WORKER_CONCURRENCY,POLL_INTERVAL_MS,AGENT_MODE,REAPER_INTERVAL_MS,DEV_FAULTS,LOG_DIR,LOG_MAX_BYTES,LOG_BACKUP_COUNT,LLM_PROVIDER,LLM_MODEL,LLM_THINKING,MEMORY_ENABLED,MEMORY_STRATEGY,SUMMARIZER_PROVIDER,SUMMARIZER_MODEL,SUMMARIZE_AFTER_MS,MEMORY_HYDRATION_BUDGET,MEMORY_RUN_WRITE_CAP,MEMORY_ACTIVE_CAP,MEMORY_EVENT_POLL_MS,KNOWLEDGE_BASE_PATH,KNOWLEDGE_BASE_RELOAD --allow-read=./data,./schema.sql --allow-write=./data src/db/client.ts",
    "dev:ui": "deno run --watch=fixtures/,wiki/ --allow-env=DATABASE_PATH,LOCK_TIMEOUT_MS,MAX_RETRIES,LOG_LEVEL,DEV_UI_PORT,PORT,WORKER_CONCURRENCY,POLL_INTERVAL_MS,AGENT_MODE,REAPER_INTERVAL_MS,DEV_FAULTS,LOG_DIR,LOG_MAX_BYTES,LOG_BACKUP_COUNT,LLM_PROVIDER,LLM_MODEL,LLM_THINKING,MEMORY_ENABLED,MEMORY_STRATEGY,SUMMARIZER_PROVIDER,SUMMARIZER_MODEL,SUMMARIZE_AFTER_MS,MEMORY_HYDRATION_BUDGET,MEMORY_RUN_WRITE_CAP,MEMORY_ACTIVE_CAP,MEMORY_EVENT_POLL_MS,KNOWLEDGE_BASE_PATH,KNOWLEDGE_BASE_RELOAD --allow-read=./data,./schema.sql,./tools/ui,./fixtures,./wiki,./.env --allow-write=./data --allow-net=127.0.0.1 tools/ui/server.ts",
    "wiki:check": "deno run --allow-env --allow-read=./wiki --allow-write=./wiki/coverage.md tools/wiki.ts --check",
    "wiki:search": "deno run --allow-env --allow-read=./wiki tools/wiki.ts --search",
    "test": "deno test --allow-read --allow-write --allow-env tests/"
  },
  "imports": {
    "@earendil-works/pi-agent-core": "npm:@earendil-works/pi-agent-core@^0.84.3",
    "@earendil-works/pi-ai": "npm:@earendil-works/pi-ai@^0.84.3",
    "@std/assert": "jsr:@std/assert@1",
    "@std/log": "jsr:@std/log@^0.224.14"
  }
}
