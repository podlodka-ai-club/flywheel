{
  "name": "triage-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "test": "npm test --workspace=server",
    "test:client": "npm test --workspace=client",
    "test:e2e": "npm test --workspace=e2e",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
